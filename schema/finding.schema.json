{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shroodler.local/schema/finding.schema.json",
  "title": "Shroodler crawl output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "scan_started_at",
    "scan_finished_at",
    "crawler",
    "pages",
    "findings",
    "js_endpoints"
  ],
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Base URL that was crawled"
    },
    "scan_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "scan_finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "crawler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["static", "headless"] }
      }
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "js_endpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/js_endpoint" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "status_code",
        "forms",
        "params",
        "cookies",
        "headers",
        "js_files"
      ],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "status_code": { "type": "integer", "minimum": 0, "maximum": 599 },
        "forms": {
          "type": "array",
          "items": { "$ref": "#/$defs/form" }
        },
        "params": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cookies": {
          "type": "array",
          "items": { "$ref": "#/$defs/cookie" }
        },
        "headers": { "$ref": "#/$defs/header_analysis" },
        "js_files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "method", "fields"],
      "properties": {
        "action": { "type": "string" },
        "method": { "type": "string" },
        "enctype": { "type": ["string", "null"] },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/form_field" }
        }
      }
    },
    "form_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "hidden"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "hidden": { "type": "boolean" },
        "disabled": { "type": ["boolean", "null"] },
        "readonly": { "type": ["boolean", "null"] }
      }
    },
    "cookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "secure", "http_only", "same_site"],
      "properties": {
        "name": { "type": "string" },
        "secure": { "type": "boolean" },
        "http_only": { "type": "boolean" },
        "same_site": {
          "type": ["string", "null"],
          "enum": ["Strict", "Lax", "None", null]
        }
      }
    },
    "header_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "missing"],
      "properties": {
        "present": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "category", "url", "description", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "category": {
          "type": "string",
          "enum": [
            "header",
            "cookie",
            "secret",
            "exposed-file",
            "js-endpoint",
            "verbose-error",
            "autocomplete"
          ]
        },
        "url": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "js_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "endpoint"],
      "properties": {
        "source": { "type": "string" },
        "endpoint": { "type": "string" }
      }
    }
  }
}
