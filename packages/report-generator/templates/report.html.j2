<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Shroodler report — {{ target }}</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; background: #211A17; color: #EDE8C8; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #4A4038; padding: 0.4rem 0.6rem; text-align: left; }
    .critical { color: #E5484D; }
    .high { color: #F0883E; }
    .medium { color: #E8B339; }
    .low { color: #5B9BD1; }
    .info { color: #8B8A85; }
    code { font-family: ui-monospace, monospace; }
    .risk-summary { display: flex; align-items: center; gap: 1.5rem; margin: 1rem 0; }
    .risk-grade {
      font-size: 2.5rem; font-weight: bold; border-radius: 0.5rem; width: 3rem; height: 3rem;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      background: #332822;
    }
    .risk-grade.grade-A, .risk-grade.grade-B { color: #5B9BD1; }
    .risk-grade.grade-C { color: #E8B339; }
    .risk-grade.grade-D, .risk-grade.grade-F { color: #E5484D; }
    .risk-counts span { margin-right: 1rem; }
  </style>
</head>
<body>
  <h1>Shroodler report</h1>
  <p>Target: <code>{{ target }}</code></p>
  <p>Crawler: {{ crawler.name }} {{ crawler.version }} ({{ crawler.mode }})</p>
  <p>{{ pages|length }} pages · {{ findings|length }} findings{% if grouped %} · {{ grouped|length }} distinct{% endif %}</p>
  {% if risk %}
  <h2>Executive summary</h2>
  <div class="risk-summary">
    <div class="risk-grade grade-{{ risk.grade }}">{{ risk.grade }}</div>
    <div class="risk-counts">
      <span class="critical">{{ risk.severity_counts.critical }} critical</span>
      <span class="high">{{ risk.severity_counts.high }} high</span>
      <span class="medium">{{ risk.severity_counts.medium }} medium</span>
      <span class="low">{{ risk.severity_counts.low }} low</span>
      <span class="info">{{ risk.severity_counts.info }} info</span>
    </div>
  </div>
  <p style="font-size: 0.9rem;">
    Grade weighted by distinct finding type, not raw per-page instance
    count, and floored by the single worst severity present (one
    critical can never be outscored by a pile of minor notes) -- a
    rough at-a-glance signal, not a substitute for reading the findings
    below.
    {% if risk.partial_coverage %}
    <strong>This scan reports it could not fully test the target</strong>
    (a WAF challenge, a skipped probe, or a truncated redirect chain
    appears below) -- treat this grade as a lower bound, not a clean
    bill of health.
    {% endif %}
  </p>
  {% endif %}
  {% if grouped %}
  <h2>Summary (by finding)</h2>
  <table>
    <thead>
      <tr><th>Severity</th><th>ID</th><th>Count</th><th>Description</th><th>Cost of attack</th><th>Remediation</th></tr>
    </thead>
    <tbody>
    {% for g in grouped %}
      <tr>
        <td class="{{ g.severity }}">{{ g.severity }}</td>
        <td><code>{{ g.id }}</code></td>
        <td>{{ g.count }}</td>
        <td>{{ g.description }}</td>
        <td>{{ g.cost_of_attack }}</td>
        <td>{{ g.remediation }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
  <h2>Findings (detail)</h2>
  <table id="detail-findings">
    <thead>
      <tr><th>Severity</th><th>ID</th><th>Category</th><th>URL</th><th>Description</th><th>Confidence</th><th>Cost of attack</th></tr>
    </thead>
    <tbody>
    {% for f in findings|sort(attribute='severity_rank') %}
      <tr>
        <td class="{{ f.severity }}">{{ f.severity }}</td>
        <td><code>{{ f.id }}</code></td>
        <td>{{ f.category }}</td>
        <td><code>{{ f.url }}</code></td>
        <td>{{ f.description }}</td>
        <td>{{ f.confidence or "" }}</td>
        <td>{{ f.cost_of_attack }}</td>
      </tr>
    {% else %}
      <tr><td colspan="7">No findings.</td></tr>
    {% endfor %}
    </tbody>
  </table>
</body>
</html>
