#compdef shroodler
# Zsh completion for the `shroodler` CLI.
#
# Install: drop this file (named exactly `_shroodler`) somewhere on your
# $fpath, e.g.:
#   cp packages/cli/completions/_shroodler ~/.zsh/completions/_shroodler
#   # ~/.zshrc: fpath=(~/.zsh/completions $fpath); autoload -Uz compinit; compinit
#
# Static, hand-maintained (no argcomplete dependency) -- keep in sync with
# shroodler/cli.py if you add/rename subcommands or flags.

_shroodler_commands=(
  'crawl:Crawl a target URL'
  'diff:Compare crawl JSON to expected_findings.json'
  'report:Render findings JSON as HTML, CSV, SARIF, JUnit, or Markdown'
  'baseline:Write expected_findings.json from a scan'
  'expected:Write expected_findings.json from a scan (alias of baseline)'
  'ingest-sessions:Turn captured proxy JSONL into findings'
  'ingest-har:Turn a Burp/mitmproxy/Caido/DevTools HAR into crawl JSON'
  'tokens:Analyze reset/verification token predictability from proxy JSONL'
  'cadence:Print recommended flags for a PR/nightly/weekly scan'
  'triage:Classify a host list before spending crawl budget'
  'payload:Run YAML payload packs against crawl JSON'
  'nuclei-ingest:Convert local Nuclei HTTP YAML into a payload pack'
  'slither-ingest:Convert a local Slither JSON report into findings'
  'authz-diff:Replay a privileged crawl under a second session'
  'peer-write:Replay known-object writes as a second session'
  'session-export:Write a Playwright storageState JSON from a browser or captured jar'
  'js-routes:Extract parameterized URL templates from a JS bundle'
  'paced-fetch:GET a URL list at a capped request rate'
  'proxy:Forward to shroodler-proxy'
  'history:Record and list local scan history'
  'trend:Diff findings between two recorded scans'
  'ask:Ask a question over a scan/report'
  'mcp-server:Run the MCP server exposing Shroodler as agent tools'
  'audit-verify:Verify a guardrail audit-log hash chain is intact'
  'compare-engines:Merge Python/Go crawl JSON as a confidence signal'
  'ticket:File or sync GitHub issues from findings (dry-run by default)'
  'sla:Attach ownership + SLA-escalated severity to findings'
  'suppress:Work with suppression rules beyond diff/report/baseline'
  'reverify:Re-scan a route and check if a finding is now gone'
  'gen-regression-test:Generate a pytest test from a confirmed-fixed finding'
  'attack-path:Correlate findings with reachability + weak-token context'
  'self-scan:Fuzz the tool'"'"'s own report renderers with hostile content'
  'program:Per-program engagement memory (endpoints, object IDs, coverage)'
  'version:Print version'
)

_shroodler() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-V --version)'{-V,--version}'[Print version and exit]' \
    '--debug[Print full tracebacks on error]' \
    '1: :->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe 'command' _shroodler_commands
      ;;
    args)
      case $line[1] in
        crawl)
          _arguments \
            '--profile[Apply a preset bundle of defaults]:(safe balanced aggressive)' \
            '--mode[Crawl mode]:(static headless)' \
            '--depth[Max depth; -1 for unbounded]:depth' \
            '--max-pages[Stop after this many pages]:count' \
            '--max-time[Wall-clock budget in seconds]:seconds' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--format[Output format]:(json html csv sarif junit)' \
            '--ignore-robots[Ignore robots.txt]' \
            '--no-sitemap[Skip sitemap discovery]' \
            '--allow-external[Allow crawling a non-local target]' \
            '--check-rate-limit[Probe login forms for missing rate limiting]' \
            '--no-check-rate-limit[Force rate-limit probing off, overriding a --profile]' \
            '--check-idor[Replay adjacent numeric IDs in the same session to check for IDOR]' \
            '*--header[Extra request header]:header' \
            '--user-agent[Override the User-Agent sent on every crawl request]:user-agent' \
            '*--cookie[Cookie name=value]:cookie' \
            '--cookie-jar[Cookie jar file]:file:_files' \
            '--storage-state[Playwright storageState JSON]:file:_files' \
            '--login-recipe[Login recipe JSON]:file:_files' \
            '--reauth-max-retries[Max mid-crawl login-recipe retries (default 3)]:n' \
            '--program[Merge crawl into program engagement memory]:slug' \
            '--proxy[HTTP proxy URL]:url' \
            '*--seed[Extra same-origin URL to enqueue]:url' \
            '*--spec[Local OpenAPI or Postman collection to seed from]:file:_files' \
            '--seed-from[HAR or proxy session JSONL]:file:_files' \
            '--from-capture[Ingest captured pages, live-crawl only new seeds]:file:_files' \
            '--cookies-from[HAR or proxy session JSONL]:file:_files' \
            '*--gql-schema[Clairvoyance / introspection JSON for GraphQL field names]:file:_files' \
            '*--gql-wordlist[GraphQL field-name wordlist]:file:_files' \
            '*--plugin[Plugin dir or file]:file:_files' \
            '*--exclude-path[Exclude URLs matching this path prefix]:path' \
            '1:target url'
          ;;
        diff)
          _arguments \
            '--pages-only[Only compare page coverage]' \
            '--gate[CI mode: fail on new findings]' \
            '--suppressions[Suppression rules file]:file:_files' \
            '--format[Output format]:(text junit sarif github-annotations)' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--source-root[Attribute new findings to source file/line under this dir]:dir:_files -/' \
            '1:findings json:_files' \
            '2:expected json:_files'
          ;;
        report)
          _arguments \
            '--format[Output format]:(html csv json sarif junit md markdown)' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--suppressions[Suppression rules file]:file:_files' \
            '*--merge-sarif[Fold an external SARIF file into the report]:file:_files' \
            '1:findings json:_files'
          ;;
        baseline|expected)
          _arguments \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--name[Baseline name]:name' \
            '--suppressions[Suppression rules file]:file:_files' \
            '1:findings json:_files'
          ;;
        ingest-sessions)
          _arguments \
            '--target[Target URL override]:url' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--allow-external[Allow ingesting a non-local session]' \
            '1:sessions jsonl:_files'
          ;;
        ingest-har)
          _arguments \
            '--target[Target URL override]:url' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--allow-external[Allow ingesting a non-local HAR]' \
            '1:har file:_files'
          ;;
        tokens)
          _arguments \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '1:sessions jsonl:_files'
          ;;
        cadence)
          _arguments \
            '--tier[Cadence slot]:(pr nightly weekly)' \
            '--url[Placeholder target URL in the printed command]:url' \
            '--format[Output format]:(text json)' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files'
          ;;
        triage)
          _arguments \
            '*--discover[Expand apex via Certificate Transparency]:apex' \
            '--no-active[Skip the HTTP classification probe]' \
            '--allow-external[Allow non-local hosts and CT discovery]' \
            '--concurrency[Max parallel probes]:count' \
            '--rate[Global requests/second cap]:rps' \
            '--timeout[Per-request timeout seconds]:seconds' \
            '--proxy[HTTP proxy URL]:url' \
            '--user-agent[Identifying User-Agent]:user-agent' \
            '*--header[Required custom header]:header' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--format[Output format]:(text json hosts)' \
            '--hosts-out[Write worth-crawling URL list]:file:_files' \
            '*:host or hosts file:_files'
          ;;
        payload)
          _arguments \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '*--pack[Extra YAML pack file or directory]:file:_files' \
            '*--plugin[Plugin dir or file supplying extra packs]:file:_files' \
            '--allow-external[Allow sending payloads to a non-local target]' \
            '--oob-host[Your own collaborator-style server for blind SSRF/XXE checks]:host' \
            '--require-policy[Refuse to run unless the target publishes a scan-policy manifest]' \
            '--policy-file[Use a local scan-policy.json instead of fetching one]:file:_files' \
            '--audit-log[Append a JSONL audit trail of allowed/blocked requests]:file:_files' \
            '--adaptive[Retry once with an adapted payload on a baseline miss]' \
            '--no-csrf[Do not harvest or attach CSRF tokens]' \
            '1:crawl json:_files'
          ;;
        nuclei-ingest)
          _arguments \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '*:nuclei yaml:_files'
          ;;
        slither-ingest)
          _arguments \
            '--target[Override document target]:target' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '1:slither json:_files'
          ;;
        authz-diff)
          _arguments \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '*--cookie[Lower-priv session cookie name=value]:cookie' \
            '*--header[Lower-priv session extra header]:header' \
            '--no-anon-check[Skip the anonymous control request]' \
            '--allow-external[Allow replaying against a non-local target]' \
            '--require-policy[Refuse to run unless the target publishes a scan-policy manifest]' \
            '--policy-file[Use a local scan-policy.json instead of fetching one]:file:_files' \
            '--audit-log[Append a JSONL audit trail of allowed/blocked requests]:file:_files' \
            '*--higher-priv-marker[Higher-priv identity string; a match confirms the lead]:string' \
            '*--lower-priv-marker[Lower-priv identity string, rules out coincidental matches]:string' \
            '--require-identity-confirmation[Drop unconfirmed leads instead of reporting them]' \
            '*--gql-schema[Clairvoyance / introspection JSON for GraphQL field names]:file:_files' \
            '*--gql-wordlist[GraphQL field-name wordlist]:file:_files' \
            '--program[Mark replayed URLs as tested_authz in program memory]:slug' \
            '1:higher-priv crawl json:_files'
          ;;
        peer-write)
          _arguments \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--target[Override playbook target]:url' \
            '--from-sessions[HAR or proxy JSONL]:file:_files' \
            '--only-id[Only replay this known object id]:id' \
            '*--owner-cookie[Owner session cookie name=value]:cookie' \
            '*--peer-cookie[Peer session cookie name=value]:cookie' \
            '--owner-cookies-from[Owner cookies file]:file:_files' \
            '--peer-cookies-from[Peer cookies file]:file:_files' \
            '*--header[Extra header]:header' \
            '--rate[Minimum seconds between requests]:seconds' \
            '--nonsense-id[Control id substituted into the same write]:id' \
            '--user-agent[Override User-Agent]:ua' \
            '--user-agent-suffix[Appended to User-Agent]:suffix' \
            '--allow-external[Allow replaying against a non-local target]' \
            '--require-policy[Refuse to run unless the target publishes a scan-policy manifest]' \
            '--policy-file[Use a local scan-policy.json instead of fetching one]:file:_files' \
            '--audit-log[Append a JSONL audit trail of allowed/blocked requests]:file:_files' \
            '--csrf-from[URL to harvest a CSRF token from]:url' \
            '--no-csrf[Do not harvest or attach a CSRF token]' \
            '--require-confirm[Only emit a finding when the owner re-read changed]' \
            '--allow-unconfirmed[Emit probable leads even when both jars are set]' \
            '--program[Mark replayed write URLs as tested_peer_write]:slug' \
            '--from-program[Pull stored object IDs from program memory]:slug' \
            '1:playbook json:_files'
          ;;
        session-export)
          _arguments \
            '--from[HAR, proxy JSONL, Netscape jar, or storageState]:file:_files' \
            '--cdp[Chrome DevTools URL]:url' \
            '--origin[Only keep cookies matching this origin]:url' \
            '*--cookie[Include this cookie name=value]:cookie' \
            '--allow-external[Allow --cdp against a non-local DevTools URL]' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files'
          ;;
        js-routes)
          _arguments \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '1:javascript file:_files'
          ;;
        paced-fetch)
          _arguments \
            '*--url[URL to fetch]:url' \
            '--urls-file[Text file of URLs]:file:_files' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--method[Safe method]:(GET HEAD OPTIONS)' \
            '*--cookie[Cookie name=value]:cookie' \
            '*--header[Extra header]:header' \
            '--rate[Minimum seconds between requests]:seconds' \
            '--user-agent[Override User-Agent]:ua' \
            '--user-agent-suffix[Appended to User-Agent]:suffix' \
            '--allow-external[Allow fetching a non-local target]' \
            '--require-policy[Refuse to run unless the target publishes a scan-policy manifest]' \
            '--policy-file[Use a local scan-policy.json instead of fetching one]:file:_files' \
            '--audit-log[Append a JSONL audit trail of allowed/blocked requests]:file:_files'
          ;;
        history)
          _values 'history subcommand' 'record[Save a scan into history]' 'list[List recorded scans]'
          ;;
        program)
          _values 'program subcommand' \
            'init[Create program state]' \
            'status[Print coverage and stale sessions]' \
            'merge[Ingest a crawl JSON]' \
            'add-session[Record a session jar path]'
          ;;
        trend)
          _arguments \
            '--format[Output format]:(text json)' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--history-dir[Override history directory]:dir:_files -/' \
            '--suppressions[Suppression rules file]:file:_files' \
            '--gate-on-severity-increase[Exit 1 if a same-key finding got a worse severity]' \
            '--gate-on-waf-coverage-drop[Exit 1 if WAF challenge coverage dropped significantly]' \
            '--waf-drop-threshold[Minimum coverage drop to count as a regression]:fraction' \
            '--gate-even-if-page-count-mismatch[Gate even when page counts differ by more than 2x]' \
            '1:older scan id or file' \
            '2:newer scan id or file'
          ;;
        proxy)
          _message 'arguments forwarded to shroodler-proxy'
          ;;
        ask)
          _arguments \
            '--since[Older scan to compare against for new/resolved questions]:file:_files' \
            '1:question' \
            '2:scan json:_files'
          ;;
        mcp-server)
          _arguments \
            '--list-tools[Print the tool catalog as JSON and exit]'
          ;;
        audit-verify)
          _arguments '1:audit log jsonl:_files'
          ;;
        compare-engines)
          _arguments \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '1:python crawl json:_files' \
            '2:go crawl json:_files'
          ;;
        ticket)
          _values 'ticket subcommand' \
            'file[Open issues for new findings]' \
            'sync[File new findings and close resolved tickets]'
          ;;
        sla)
          _values 'sla subcommand' 'apply[Resolve owner + SLA-escalated severity]'
          ;;
        suppress)
          _values 'suppress subcommand' 'expiring[List rules expiring soon / render a PR body]'
          ;;
        reverify)
          _arguments \
            '--mode[Crawl mode]:(static headless)' \
            '--allow-external[Allow a non-local target]' \
            '--no-payloads[Skip active payload packs]' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--require-policy[Refuse active payloads without a scan-policy manifest]' \
            '--policy-file[Local scan-policy.json]:file:_files' \
            '--audit-log[Audit trail file]:file:_files' \
            '1:url' \
            '2:finding id'
          ;;
        gen-regression-test)
          _arguments \
            '--mode[Crawl mode]:(static headless)' \
            '--allow-external[Allow a non-local target]' \
            '--no-payloads[Skip active payload packs]' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '--force[Generate even if reverify returned a warning]' \
            '1:url' \
            '2:finding id'
          ;;
        attack-path)
          _arguments \
            '--format[Output format]:(json markdown)' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files' \
            '1:findings json:_files'
          ;;
        self-scan)
          _arguments \
            '*--format[Limit to specific format(s)]:(html csv sarif junit markdown)' \
            '(--output -o)'{--output,-o}'[Output file]:file:_files'
          ;;
      esac
      ;;
  esac
}

_shroodler "$@"
